    "m_SourceType": 1,
    "m_FunctionName": "CUstomShadow",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "#if defined(SHADERGRAPH_PREVIEW)\n    Direction = float3(0.5, 0.5, 0);\n    ShadowAtten = 1.0;\n#else\n    Light mainLight = GetMainLight(TransformWorldToShadowCoord(WorldPos));\n    Direction = mainLight.direction;\n    ShadowAtten = mainLight.shadowAttenuation;\n#endif"
}

